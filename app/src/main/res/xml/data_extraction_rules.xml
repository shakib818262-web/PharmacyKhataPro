<?xml version="1.0" encoding="utf-8"?>
<!-- Device-transfer / cloud backup rules (API 31+). Mirrors backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="pharmacy_pro.db" />
        <include domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.installations.xml" />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="pharmacy_pro.db" />
        <include domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<!-- Device-transfer / cloud backup rules (API 31+). Mirrors backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Inclusion list only (see backup_rules.xml note on FullBackupContent). -->
        <include domain="database" path="pharmacy_pro.db" />
        <include domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="pharmacy_pro.db" />
        <include domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>

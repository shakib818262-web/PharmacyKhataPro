<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules (API < 31). Business data lives in the Room database; we back it up
  only via Android's encrypted Auto Backup transport. Firebase Auth tokens and device-bound
  files are excluded. The app also offers a manual, versioned JSON export in Settings.
-->
<full-backup-content>
    <!-- Inclusion list: with any <include> present, ONLY these paths are backed up.
         (Lint FullBackupContent: an <exclude> is only valid inside an included path,
         so the old excludes of never-included areas were errors, not safeguards.)
         Firebase installations data and all other files/sharedprefs stay excluded
         simply by not being listed here. -->
    <include domain="database" path="pharmacy_pro.db" />
    <include domain="sharedpref" path="session.xml" />
</full-backup-content>
